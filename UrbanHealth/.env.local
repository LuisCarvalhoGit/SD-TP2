# === LOCAL DEVELOPMENT MODE ===
# Use this for local development with docker-compose
# All services communicate via Docker internal network using service names as hostnames

ENVIRONMENT=Development
MODE=LOCAL

# SYSTEM PORTS
PORT_DASHBOARD=8081
PORT_SERVER_TCP=5001
PORT_RABBITMQ=5672
PORT_RABBITMQ_WEB=15672
PORT_PYTHON_PRE=50051
PORT_PYTHON_ANALY=50052
PORT_SENSOR_UDP=5002
PORT_GATEWAY_UDP=5004
PORT_SERVER_UDP=5003

# CREDENTIALS
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# NETWORK ADDRESSING (LOCAL - Docker Service Names)
GATEWAY_IP=csharp-gateway
GATEWAY_UDP_PORT=5004
SERVER_IP=csharp-server
SERVER_PORT=5001
SERVER_UDP_PORT=5003
RABBITMQ_HOST=rabbitmq

# INTERNAL VARIABLES
PYTHONUNBUFFERED=1
DB_PATH=/app/data/urbanhealth_central.db
ANALYSIS_RPC_URL=http://python-analysis:50052
PREPROCESS_RPC_URL=http://python-preprocess:50051
