# === LOCAL DEVELOPMENT MODE ===
# Loaded by docker-compose.yml as container environment.
# App endpoints are defined in JSON config files; this file keeps host ports,
# RabbitMQ credentials, and runtime-only settings.

ENVIRONMENT=Development
MODE=LOCAL

# Host ports
PORT_DASHBOARD=8081
PORT_SERVER_TCP=5001
PORT_RABBITMQ=5672
PORT_RABBITMQ_WEB=15672
PORT_PYTHON_PRE=50051
PORT_PYTHON_ANALY=50052
PORT_SENSOR_UDP=5002
PORT_GATEWAY_UDP=5004
PORT_SERVER_UDP=5003

# RabbitMQ image credentials
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

PYTHONUNBUFFERED=1
DB_PATH=/app/data/urbanhealth_central.db
