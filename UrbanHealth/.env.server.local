# === SERVER LOCAL MODE ===
# For local development: connects to Analysis via Docker internal network

ENVIRONMENT=Development
MODE=LOCAL

PORT_DASHBOARD=8081
PORT_SERVER_TCP=5001
PORT_PYTHON_ANALY=50052
PORT_SERVER_UDP=5003
DB_PATH=/app/data/urbanhealth_central.db
ANALYSIS_RPC_URL=http://python-analysis:50052
PYTHONUNBUFFERED=1

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
