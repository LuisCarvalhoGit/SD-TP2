# === GATEWAY DISTRIBUTED MODE ===
# For distributed deployment: gateway on separate machine
# ⚠️ EDIT THESE VALUES FOR YOUR DEPLOYMENT

ENVIRONMENT=Production
MODE=DISTRIBUTED

PORT_RABBITMQ=5672
PORT_RABBITMQ_WEB=15672
PORT_PYTHON_PRE=50051
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ⚠️ REPLACE with actual IP of Gateway machine (or localhost if gateway runs local preprocess)
RABBITMQ_HOST=192.168.1.150
PREPROCESS_RPC_URL=http://192.168.1.150:50051
PYTHONUNBUFFERED=1

# ⚠️ REPLACE with actual IP of Server machine
SERVER_IP=192.168.1.100
SERVER_PORT=5001
SERVER_UDP_PORT=5003
GATEWAY_UDP_PORT=5002
