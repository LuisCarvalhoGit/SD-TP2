# === GATEWAY DISTRIBUTED MODE ===
# Loaded automatically by docker-compose.gateway.yml.
# Use with: docker-compose -f docker-compose.gateway.yml up --build
#
# The broker (RabbitMQ) should be running in a separate docker-compose.broker.yml deployment.
# Update RABBITMQ_HOST to match your broker's location:
#   - Same computer: RABBITMQ_HOST=host.docker.internal
#   - Separate hosts: RABBITMQ_HOST=<broker-host-LAN-IP>

ENVIRONMENT=Production
MODE=DISTRIBUTED

# Local ports for this compose stack
PORT_PYTHON_PRE=50051
PORT_GATEWAY_UDP=5004
PORT_GATEWAY_WEB=8080

# External RabbitMQ broker (running in docker-compose.broker.yml)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# Update this if the broker is on a different host
RABBITMQ_HOST=host.docker.internal

# Services running in this compose file
PREPROCESS_RPC_URL=http://python-preprocess:50051
PYTHONUNBUFFERED=1

# Server address as seen from inside the gateway container
SERVER_IP=host.docker.internal
SERVER_PORT=5001
SERVER_UDP_PORT=5003

# Gateway UDP listener inside the container
GATEWAY_UDP_PORT=5004

# Video tuning
VIDEO_UDP_CHUNK_SIZE=1200
VIDEO_FRAME_INTERVAL_MS=200
VIDEO_FRAME_CACHE_RELOAD_MS=30000
VIDEO_PACKET_DELAY_MS=0
VIDEO_FRAME_TTL_MS=750
VIDEO_MAX_PENDING_FRAMES_PER_SENSOR=3
VIDEO_MAX_FRAME_BYTES=4194304
VIDEO_MAX_PARTS_PER_FRAME=512
VIDEO_DEBUG_PACKETS=false
GATEWAY_ENABLE_LOCAL_VIDEO_PREVIEW=false
