# === SENSOR DISTRIBUTED MODE ===
# Loaded automatically by docker-compose.sensor.yml.
# Use with: docker-compose -f docker-compose.sensor.yml up --build
#
# Same computer simulation:
#   RABBITMQ_HOST=host.docker.internal
#   GATEWAY_IP=host.docker.internal
#
# Separate hosts:
#   RABBITMQ_HOST=<gateway-host-LAN-IP>
#   GATEWAY_IP=<gateway-host-LAN-IP>

ENVIRONMENT=Production
MODE=DISTRIBUTED

RABBITMQ_HOST=host.docker.internal
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

GATEWAY_IP=host.docker.internal
GATEWAY_UDP_PORT=5004

VIDEO_UDP_CHUNK_SIZE=1200
VIDEO_FRAME_INTERVAL_MS=200
VIDEO_FRAME_CACHE_RELOAD_MS=30000
VIDEO_PACKET_DELAY_MS=0
STREAM_AUTO_STOP_ENABLED=false
STREAM_AUTO_STOP_AFTER_SECONDS=30
