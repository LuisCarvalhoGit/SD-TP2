# === SENSOR DISTRIBUTED MODE ===
# For distributed deployment: one sensor on separate machine
# ⚠️ EDIT THESE VALUES FOR YOUR DEPLOYMENT

ENVIRONMENT=Production
MODE=DISTRIBUTED

# ⚠️ REPLACE with actual IP of Gateway machine
RABBITMQ_HOST=192.168.1.150
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ⚠️ REPLACE with actual IP of Gateway machine
GATEWAY_IP=192.168.1.150
GATEWAY_UDP_PORT=5002
