# === SERVER DISTRIBUTED MODE ===
# Loaded automatically by docker-compose.server.yml.
# Use with: docker-compose -f docker-compose.server.yml up --build

ENVIRONMENT=Production
MODE=DISTRIBUTED

PORT_DASHBOARD=8081
PORT_SERVER_TCP=5001
PORT_PYTHON_ANALY=50052
PORT_SERVER_UDP=5003
SERVER_UDP_PORT=5003
DB_PATH=/app/data/urbanhealth_central.db

# Analysis runs in this compose file.
ANALYSIS_RPC_URL=http://python-analysis:50052
PYTHONUNBUFFERED=1

# Present only for consistency with shared config; the server does not require RabbitMQ.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=host.docker.internal

VIDEO_FRAME_TTL_MS=750
VIDEO_MAX_PENDING_FRAMES_PER_SENSOR=3
VIDEO_MAX_FRAME_BYTES=4194304
VIDEO_MAX_PARTS_PER_FRAME=512
VIDEO_DEBUG_PACKETS=false
