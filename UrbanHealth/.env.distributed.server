# === SERVER DISTRIBUTED MODE ===
# For distributed deployment: server on separate machine
# ⚠️ EDIT THESE VALUES FOR YOUR DEPLOYMENT

ENVIRONMENT=Production
MODE=DISTRIBUTED

PORT_DASHBOARD=8081
PORT_SERVER_TCP=5001
PORT_PYTHON_ANALY=50052
PORT_SERVER_UDP=5003
DB_PATH=/app/data/urbanhealth_central.db

# ⚠️ REPLACE with actual IP of Server machine
ANALYSIS_RPC_URL=http://192.168.1.100:50052
PYTHONUNBUFFERED=1

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ⚠️ REPLACE with actual IP of any machine in your network (for backup/resilience)
RABBITMQ_HOST=192.168.1.150
