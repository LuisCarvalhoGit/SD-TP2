# === SERVER DISTRIBUTED MODE ===
# Use with: docker compose --env-file .env.distributed.server -f docker-compose.server.yml up --build
# App endpoints are defined in ServerConfigs/server-config.json.

ENVIRONMENT=Production
MODE=DISTRIBUTED

PORT_DASHBOARD=8081
PORT_SERVER_TCP=5001
PORT_PYTHON_ANALY=50052
PORT_SERVER_UDP=5003

DB_PATH=/app/data/urbanhealth_central.db
PYTHONUNBUFFERED=1
