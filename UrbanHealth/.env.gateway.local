# === GATEWAY LOCAL MODE ===
# For local development: connects to Server and PreProcessing via Docker internal network

ENVIRONMENT=Development
MODE=LOCAL

PORT_RABBITMQ=5672
PORT_RABBITMQ_WEB=15672
PORT_PYTHON_PRE=50051
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
PREPROCESS_RPC_URL=http://python-preprocess:50051
PYTHONUNBUFFERED=1

# Connect to Server and listen for Sensor via Docker internal network
SERVER_IP=csharp-server
SERVER_PORT=5001
SERVER_UDP_PORT=5003
GATEWAY_UDP_PORT=5002
