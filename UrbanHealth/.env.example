# Copy this file to .env or pass it with docker compose --env-file if you want
# to override host ports. Service addresses live in JSON config files.

ENVIRONMENT=Development
MODE=LOCAL

PORT_DASHBOARD=8081
PORT_SERVER_TCP=5001
PORT_RABBITMQ=5672
PORT_RABBITMQ_WEB=15672
PORT_PYTHON_PRE=50051
PORT_PYTHON_ANALY=50052
PORT_SENSOR_UDP=5002
PORT_GATEWAY_UDP=5004
PORT_SERVER_UDP=5003
PORT_GATEWAY_WEB=8080

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

PYTHONUNBUFFERED=1
DB_PATH=/app/data/urbanhealth_central.db
