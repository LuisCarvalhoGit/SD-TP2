# Copy this file to .env for local development.

ENVIRONMENT=Development
MODE=LOCAL

PORT_DASHBOARD=8081
PORT_SERVER_TCP=5001
PORT_RABBITMQ=5672
PORT_RABBITMQ_WEB=15672
PORT_PYTHON_PRE=50051
PORT_PYTHON_ANALY=50052
PORT_SENSOR_UDP=5002
PORT_GATEWAY_UDP=5004
PORT_SERVER_UDP=5003
PORT_GATEWAY_WEB=8080

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Local monolithic Docker network names.
GATEWAY_IP=csharp-gateway
GATEWAY_UDP_PORT=5004
SERVER_IP=csharp-server
SERVER_PORT=5001
SERVER_UDP_PORT=5003
RABBITMQ_HOST=rabbitmq

PYTHONUNBUFFERED=1
DB_PATH=/app/data/urbanhealth_central.db
ANALYSIS_RPC_URL=http://python-analysis:50052
PREPROCESS_RPC_URL=http://python-preprocess:50051

# Low-latency UDP video defaults.
VIDEO_UDP_CHUNK_SIZE=1200
VIDEO_FRAME_INTERVAL_MS=200
VIDEO_FRAME_CACHE_RELOAD_MS=30000
VIDEO_PACKET_DELAY_MS=0
STREAM_AUTO_STOP_ENABLED=false
STREAM_AUTO_STOP_AFTER_SECONDS=30
VIDEO_FRAME_TTL_MS=750
VIDEO_MAX_PENDING_FRAMES_PER_SENSOR=3
VIDEO_MAX_FRAME_BYTES=4194304
VIDEO_MAX_PARTS_PER_FRAME=512
VIDEO_DEBUG_PACKETS=false
GATEWAY_ENABLE_LOCAL_VIDEO_PREVIEW=false
