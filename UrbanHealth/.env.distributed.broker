# === BROKER DISTRIBUTED MODE ===
# Loaded automatically by docker-compose.broker.yml.
# Use with: docker-compose -f docker-compose.broker.yml up --build
#
# This file contains the RabbitMQ broker configuration for the distributed deployment.

ENVIRONMENT=Production
MODE=DISTRIBUTED

# RabbitMQ ports
PORT_RABBITMQ=5672
PORT_RABBITMQ_WEB=15672

# RabbitMQ credentials
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_ERLANG_COOKIE=urbanhealth_edge_secret_cookie
